# Python
.venv/
__pycache__/
*.pyc
*.pyo

# 运行时生成
activation.dat
错误截图/

# 环境变量（含私钥，绝对不提交）
.env

# 模板图：默认模板已打包进仓库（见 templates/），通常不用自己截
# 如果在某台机器上重新校准过，新的模板图会以"已修改"出现，正常提交覆盖即可

# PyInstaller 打包产物（体积大，不进仓库，本地重新打包即可）
build/
dist/

# macOS
.DS_Store

# 本地工具配置（非项目内容）
.claude/

# 调试临时物（本地测试脚本、诊断截图，不进仓库）
test_retry.py
printwindow_capture.png

# 运行时日志：程序每次跑自动生成，纯运行噪音，不进仓库（logger.py 会自建 logs/ 目录）
logs/

# 从网上下载的真实测试图（第三方版权图片，不是项目自己生成的素材，不提交）
test_images_real/

# 手机版（phone/）：adb 工具包体积大，用户自备，不进仓库
phone/platform-tools/
phone/**/logs/
phone/**/错误截图/
phone/delivery_test_assets/
phone/tmp_delivery_video/
# 运行时坐标 Profile 库（内置种子在 device_profile.py 里，这个是运行时落盘的可写副本）
phone/device_profiles.json
phone/device_registry.json
phone/activation.dat
